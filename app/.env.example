# Copy to `app/.env`. Read by `next dev` and `next build`; compose substitutes
# WEB_PORT from it (app/ is the compose project directory).

# Host port for the Next.js dev server. The container always listens on 3000.
WEB_PORT=3000

# Where the BROWSER reaches the two back-end services.
#
# Leave both empty for local development: the app then uses the host the page
# was loaded from with ports 3002 (api) and 3001 (core), which also works when
# the customer phone page is opened from a second device on the same network.
# Set them only when the services live somewhere else. NEXT_PUBLIC_ values are
# inlined into the bundle at build time.
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_CORE_URL=
