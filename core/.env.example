# Copy to `core/.env`. This is the ONLY config file the core service reads
# (`bun run start` and its container both load it). It is gitignored: keep
# secrets here, never in the repo.
#
# In Docker, core/docker-compose.yml overrides the host addresses below with
# the in-network ones (db, cache, api, media, speech).

# ── Service ─────────────────────────────────────────────────────────────────
# The port core listens on when run locally. In Docker it is the host port
# only: the container always listens on 3001.
CORE_PORT=3001
CORE_DEBUG_PORT=9229
# Where core reaches the api service (system of record and policy engine).
API_INTERNAL_URL=http://localhost:3002
BANK_NAME=Demo Bank

# ── Database (secret) ───────────────────────────────────────────────────────
# Must match the credentials the `db` container was created with (root .env).
DB_HOST=localhost
DB_PORT=5433
DB_USER=capitalwise
DB_PASSWORD=capitalwise_dev
DB_NAME=capitalwise

# ── Cache / live events (secret) ────────────────────────────────────────────
# Must match the `cache` container (root .env).
CACHE_HOST=localhost
CACHE_PORT=6380
CACHE_PASSWORD=capitalwise_dev

# ── LiveKit (`media`): carries all call audio ───────────────────────────────
# How core reaches LiveKit.
LIVEKIT_URL=ws://localhost:7880
# What browsers use. Empty = the browser uses ws://<page hostname>:7880.
LIVEKIT_PUBLIC_URL=
# Must match MEDIA_API_KEY / MEDIA_API_SECRET in the root .env (secret).
LIVEKIT_API_KEY=capitalwise
LIVEKIT_API_SECRET=capitalwise_dev_media_secret_change_me_now

# ── AI: which provider serves each capability ───────────────────────────────
# Providers: ollama | vllm | openai | speaches
#   ollama   chat                            (native API, thinking switched off)
#   vllm     chat, speech-to-text (Whisper)
#   openai   chat, speech-to-text, text-to-speech
#   speaches speech-to-text, text-to-speech (Whisper, Kokoro, Piper)
# Audition models and voices without restarting: GET /core/ai/status,
# POST /core/ai/chat, POST /core/ai/transcriptions, POST /core/ai/speech.

# Chat (the language model with tools). Use a NON-thinking (instruct) model:
# a thinking model adds seconds of silence before every answer and is not
# suitable for voice. AI_CHAT_REASONING_EFFORT=none switches thinking off
# where the backend allows it (Ollama `think: false`, vLLM
# `enable_thinking: false`); OpenAI only receives it when it is not "none".
AI_CHAT_PROVIDER=ollama
AI_CHAT_MODEL=gpt-6:luna
AI_CHAT_TEMPERATURE=0.4
AI_CHAT_MAX_OUTPUT_TOKENS=300
AI_CHAT_TIMEOUT_MS=30000
AI_CHAT_REASONING_EFFORT=none

# Speech-to-text (the caller's words).
AI_STT_PROVIDER=speaches
AI_STT_MODEL=Systran/faster-whisper-small.en
AI_STT_LANGUAGE=en

# Text-to-speech. Kokoro voices: British bf_emma, bf_isabella, bm_george,
# bm_lewis; American af_heart, af_bella, am_adam ... (no Australian voice).
# The staff voice speaks typed takeover replies.
AI_TTS_PROVIDER=speaches
AI_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
AI_TTS_AI_VOICE=bf_emma
AI_TTS_STAFF_VOICE=bm_george
AI_TTS_SPEED=1.0

# ── AI provider connections (only the ones you use need values) ─────────────
# Ollama's native API root, no /v1 (e.g. http://localhost:11434, or
# http://host.docker.internal:11434 when core runs in Docker and Ollama on the host).
OLLAMA_BASE_URL=
# Optional bearer token for a protected self-hosted Ollama.
OLLAMA_API_KEY=
# vLLM's OpenAI-compatible root, e.g. http://gpu-box:8000/v1
VLLM_BASE_URL=
VLLM_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SPEACHES_BASE_URL=http://localhost:8000/v1
SPEACHES_API_KEY=

# ── Turn detection (the caller's speech) ────────────────────────────────────
# Speech starts after this much audio above the threshold.
VAD_SPEECH_START_MS=200
# The caller's turn ends after this much silence.
VAD_END_OF_TURN_SILENCE_MS=700
# Speech must be this many times louder than the background noise.
VAD_ENERGY_THRESHOLD_RATIO=3

# ── Hold buffer (what the caller hears while the AI checks the system) ──────
# A "still checking" reminder this often (at most three per hold).
HOLD_REMINDER_INTERVAL_MS=8000
# Holds longer than this end with "Thanks for holding."
HOLD_RETURN_THRESHOLD_MS=2500
# A soft tone between hold lines.
HOLD_TONE_ENABLED=true

# ── Cost estimate (all 0: every model is self-hosted) ───────────────────────
PRICE_PER_1M_LLM_INPUT_TOKENS_USD=0
PRICE_PER_1M_LLM_OUTPUT_TOKENS_USD=0
PRICE_PER_MINUTE_STT_USD=0
PRICE_PER_1M_TTS_CHARACTERS_USD=0
