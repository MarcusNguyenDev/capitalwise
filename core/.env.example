# Copy to `core/.env`. This is the ONLY config file the core service reads
# (`bun run start` and its container both load it). It is gitignored: keep
# secrets here, never in the repo.
#
# In Docker, core/docker-compose.yml overrides the host addresses below with
# the in-network ones (db, cache, api, media, speech).

# ── Service ─────────────────────────────────────────────────────────────────
# The port core listens on when run locally. In Docker it is the host port
# only: the container always listens on 3001.
CORE_PORT=3001
CORE_DEBUG_PORT=9229
# Where core reaches the api service (system of record and policy engine).
API_INTERNAL_URL=http://localhost:3002
BANK_NAME=Demo Bank
# The bank's time zone. The voice agent tells the model today's date in it.
BANK_TIME_ZONE=Australia/Brisbane

# ── Database (secret) ───────────────────────────────────────────────────────
# Must match the credentials the `db` container was created with (root .env).
DB_HOST=localhost
DB_PORT=5433
DB_USER=capitalwise
DB_PASSWORD=capitalwise_dev
DB_NAME=capitalwise

# ── Cache / live events (secret) ────────────────────────────────────────────
# Must match the `cache` container (root .env).
CACHE_HOST=localhost
CACHE_PORT=6380
CACHE_PASSWORD=capitalwise_dev

# ── LiveKit (`media`): carries all call audio ───────────────────────────────
# How core reaches LiveKit.
LIVEKIT_URL=ws://localhost:7880
# What browsers use. Empty = the browser uses ws://<page hostname>:7880.
LIVEKIT_PUBLIC_URL=
# Must match MEDIA_API_KEY / MEDIA_API_SECRET in the root .env (secret).
LIVEKIT_API_KEY=capitalwise
LIVEKIT_API_SECRET=capitalwise_dev_media_secret_change_me_now

# ── AI: which provider serves each capability ───────────────────────────────
# Providers: openai | ollama | vllm | speaches
#   openai   chat (Chat Completions), streaming speech-to-text (Realtime
#            transcription session), speech (a Realtime model as a reader, or
#            /audio/speech for the older dedicated TTS models)
#   ollama   chat (native API, thinking switched off)
#   vllm     chat, speech-to-text (Whisper), text-to-speech (vLLM-Omni, e.g. Qwen3-TTS)
#   speaches speech-to-text, text-to-speech (Whisper, Kokoro, Piper)
# core always runs the conversation (turn detection, tools, hold lines,
# supervisor controls); no speech-to-speech model ever decides what is said.
# Audition models and voices without restarting: GET /core/ai/status,
# POST /core/ai/chat, POST /core/ai/transcriptions, POST /core/ai/speech.
#
# Default: the owner's OpenAI setup. Only OPENAI_API_KEY needs a value.
AI_CHAT_PROVIDER=openai
# gpt-6-luna calls tools in Chat Completions only with reasoning effort "none"
# (its default is "medium"). Leave AI_CHAT_REASONING_EFFORT empty for older
# models that reject the parameter (gpt-4o, gpt-4.1).
AI_CHAT_MODEL=gpt-6-luna
AI_CHAT_REASONING_EFFORT=none
AI_CHAT_TEMPERATURE=0.4
AI_CHAT_MAX_OUTPUT_TOKENS=300
# Idle timeout: restarts on every streamed chunk.
AI_CHAT_TIMEOUT_MS=30000
# Optional: this capability's own server. Empty = the provider's *_BASE_URL.
AI_CHAT_BASE_URL=

# Streaming speech-to-text: the caller's speech is streamed to one Realtime
# transcription session per call while they talk; core's own turn detection
# commits each turn (gpt-live-transcribe has no server-side VAD).
# gpt-transcribe (more accurate) and gpt-realtime-whisper stream too;
# whisper-1 is sent as a file per turn.
AI_STT_PROVIDER=openai
AI_STT_MODEL=gpt-live-transcribe
AI_STT_LANGUAGE=en
AI_STT_BASE_URL=

# Speech: a gpt-realtime… model is driven as a READER over a Realtime
# session (OpenAI's replacement for the dedicated TTS models, which shut down
# 2027-01-06). It is a conversational model with no official verbatim mode:
# core instructs it to read word for word, sends each line out of band, and
# compares what it says it said with the text (a drift is logged and counted
# in metrics.tts_drift_count; the transcript keeps the text we asked for).
# gpt-4o-mini-tts / tts-1 still work through /audio/speech until 2027-01-06.
# Best voices: marin, cedar.
AI_TTS_PROVIDER=openai
AI_TTS_MODEL=gpt-realtime-2.1-mini
AI_TTS_AI_VOICE=marin
AI_TTS_STAFF_VOICE=cedar
AI_TTS_SPEED=1.0
# Optional tone guidance (appended to the reader instructions; sent as
# `instructions` to vLLM-Omni and gpt-4o-mini-tts). Speaches ignores it.
AI_TTS_INSTRUCTIONS=
AI_TTS_BASE_URL=

# ── Self-hosted alternatives (copy a block over the values above) ───────────
#
# Chat on a self-hosted Ollama (use a NON-thinking/instruct model: a
# thinking model adds seconds of silence before every answer):
#   AI_CHAT_PROVIDER=ollama
#   AI_CHAT_MODEL=qwen3:4b-instruct
#   OLLAMA_BASE_URL=http://localhost:11434      # http://host.docker.internal:11434 from Docker
#
# Chat on vLLM (one server per model):
#   AI_CHAT_PROVIDER=vllm
#   AI_CHAT_MODEL=Qwen/Qwen3-8B
#   AI_CHAT_BASE_URL=http://gpu-box:8000/v1
#
# Speech-to-text and text-to-speech on Speaches (the root compose `speech`):
#   AI_STT_PROVIDER=speaches
#   AI_STT_MODEL=Systran/faster-whisper-small.en
#   AI_TTS_PROVIDER=speaches
#   AI_TTS_MODEL=speaches-ai/Kokoro-82M-v1.0-ONNX
#   AI_TTS_AI_VOICE=bf_emma                      # British: bf_emma, bf_isabella, bm_george, bm_lewis
#   AI_TTS_STAFF_VOICE=bm_george
#
# Qwen3-TTS on your own GPU with vLLM-Omni:
#   AI_TTS_PROVIDER=vllm
#   AI_TTS_MODEL=Qwen/Qwen3-TTS-12Hz-1.7B-CustomVoice   # GET <url>/models
#   AI_TTS_AI_VOICE=vivian                               # GET <url>/audio/voices
#   AI_TTS_STAFF_VOICE=ryan
#   AI_TTS_SPEED=1.0                                     # streaming needs speed 1.0
#   AI_TTS_INSTRUCTIONS=Warm, calm, reassuring bank specialist. Natural pace.
#   AI_TTS_BASE_URL=http://gpu-box:8091/v1

# ── AI provider connections (only the ones you use need values) ─────────────
# Ollama's native API root, no /v1 (e.g. http://localhost:11434, or
# http://host.docker.internal:11434 when core runs in Docker and Ollama on the host).
OLLAMA_BASE_URL=
# Optional bearer token for a protected self-hosted Ollama.
OLLAMA_API_KEY=
# Context window asked of Ollama (its default, 4096, is smaller than the prompt + tools).
OLLAMA_CONTEXT_TOKENS=16384
# vLLM's OpenAI-compatible root, e.g. http://gpu-box:8000/v1
VLLM_BASE_URL=
VLLM_API_KEY=
# The Realtime WebSocket URL is derived from OPENAI_BASE_URL (https -> wss),
# so pointing it at another server moves chat, transcription and speech.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
SPEACHES_BASE_URL=http://localhost:8000/v1
SPEACHES_API_KEY=

# ── Cost guards (every live call, every provider) ───────────────────────────
# Past this estimated cost (metrics.estimated_cost_usd, from the PRICE_* keys)
# the agent stops generating, apologises and asks for a person.
AI_MAX_CALL_COST_USD=1.00
# The agent says goodbye and ends the call after this many minutes.
AI_MAX_LIVE_CALL_MINUTES=15
# The agent says goodbye and ends the call after this much caller silence
# (never while a staff member has the call or the caller is on hold).
AI_IDLE_HANGUP_SECONDS=90
# Rendered fixed phrases are kept here across restarts (gitignored), keyed by
# provider + model + voice + speed + instructions + text.
# PHRASE_AUDIO_CACHE_DIR=.cache/phrase_audio

# ── Turn detection (the caller's speech) ────────────────────────────────────
# Speech starts after this much audio above the threshold.
VAD_SPEECH_START_MS=200
# The caller's turn ends after this much silence.
VAD_END_OF_TURN_SILENCE_MS=700
# Speech must be this many times louder than the background noise.
VAD_ENERGY_THRESHOLD_RATIO=3

# ── Hold buffer (what the caller hears while the AI checks the system) ──────
# A "still checking" reminder this often (at most three per hold).
HOLD_REMINDER_INTERVAL_MS=8000
# Holds longer than this end with "Thanks for holding."
HOLD_RETURN_THRESHOLD_MS=2500
# A soft tone between hold lines.
HOLD_TONE_ENABLED=true

# ── Cost estimate (USD) ─────────────────────────────────────────────────────
# Defaults are the OpenAI prices of the default setup above (model pages,
# 2026-11). Set them to 0 for self-hosted models.
# gpt-6-luna, per 1M tokens:
PRICE_PER_1M_LLM_INPUT_TOKENS_USD=0.10
PRICE_PER_1M_LLM_CACHED_INPUT_TOKENS_USD=0.01
PRICE_PER_1M_LLM_OUTPUT_TOKENS_USD=0.50
# gpt-live-transcribe, per minute of streamed speech:
PRICE_PER_MINUTE_STT_USD=0.017
# gpt-realtime-2.1-mini as the reader, per 1M tokens:
PRICE_PER_1M_TTS_TEXT_INPUT_TOKENS_USD=0.60
PRICE_PER_1M_TTS_CACHED_INPUT_TOKENS_USD=0.06
PRICE_PER_1M_TTS_AUDIO_OUTPUT_TOKENS_USD=20
PRICE_PER_1M_TTS_TEXT_OUTPUT_TOKENS_USD=2.40
# Dedicated TTS models priced per character (0 for Speaches / Qwen3-TTS):
PRICE_PER_1M_TTS_CHARACTERS_USD=0
