# Copy to `core/.env` and fill in. `core/.env` is gitignored — never commit a key.
#
# Docker Compose substitutes from this directory (core/ is the compose
# project directory), and the container loads the same file as its env, so one
# file covers both. Database and Redis credentials are NOT here — they live in
# the root .env, which the container also loads.

# ── Service ─────────────────────────────────────────────────────────────────
# Host port only. The container always listens on 3001 in development.
API_PORT=3001
API_DEBUG_PORT=9229

# ── Application ─────────────────────────────────────────────────────────────
# EXAMPLE_API_KEY=
