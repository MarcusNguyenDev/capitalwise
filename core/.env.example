# Copy to `core/.env` and fill in. `core/.env` is gitignored: never commit a key.
#
# Docker Compose substitutes from this directory (core/ is the compose project
# directory), and the container loads the same file as its env, so one file
# covers both. Database and Redis credentials are NOT here: they live in the
# root .env (DB_*, CACHE_*), which core also loads.

# ── Service ─────────────────────────────────────────────────────────────────
# The port core listens on when run locally (`bun run start`). In Docker it is
# the host port only: the container always listens on 3001.
CORE_PORT=3001
CORE_DEBUG_PORT=9229

# Where core reaches the api service (system of record and policy engine).
# Docker Compose overrides this with http://api:3002.
API_INTERNAL_URL=http://localhost:3002

# ── Application ─────────────────────────────────────────────────────────────
BANK_NAME=Demo Bank

# ── Live voice (optional) ───────────────────────────────────────────────────
# Live voice is optional. Leave OPENAI_API_KEY empty and everything else still
# works: Scripted mode and the call simulator need no key, and
# GET /core/voice/status reports is_live_available=false. The key never leaves
# core: the browser only receives a short-lived client secret.
OPENAI_API_KEY=
OPENAI_REALTIME_MODEL=gpt-realtime
OPENAI_REALTIME_VOICE=marin
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# ── Cost estimate (USD per 1M tokens of the Realtime model above) ───────────
PRICE_PER_1M_AUDIO_INPUT_USD=32
PRICE_PER_1M_AUDIO_OUTPUT_USD=64
PRICE_PER_1M_TEXT_INPUT_USD=4
PRICE_PER_1M_TEXT_OUTPUT_USD=16
PRICE_PER_1M_CACHED_INPUT_USD=0.4
