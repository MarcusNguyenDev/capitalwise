# Shared infrastructure (root docker-compose.yml). Copy to `.env` to override.
# Each infra service gets its host port and dev credentials here, named after
# the service's role.
#
# The credentials are applied only when a data volume is first created. To
# change them afterwards, change them inside the service, or wipe the data with
# `docker compose down -v`.

# PostgreSQL (service `db`). In-network: db:5432.
DB_PORT=5433
DB_USER=capitalwise
DB_PASSWORD=capitalwise_dev
DB_NAME=capitalwise

# Redis (service `cache`). In-network: cache:6379.
CACHE_PORT=6380
CACHE_PASSWORD=capitalwise_dev

# Demo settings shared by `api` and `core` (both load this file as well as
# their own .env).
BANK_NAME=Demo Bank
# Enables the "Reset demo" button, which reseeds the database from db/*.sql.
DEMO_MODE=true

# Optional. Only needed for Live voice (OpenAI Realtime); Scripted mode and the
# simulator work without it. It is read by `core` only and never sent to the
# browser. You can put it here or in core/.env.
OPENAI_API_KEY=

# The api and core dev containers load this file too, so they see the same
# DB_* and CACHE_* values (with DB_HOST/DB_PORT and CACHE_HOST/CACHE_PORT
# overridden to the in-network addresses).
#
# Ports for api, core and app live in api/.env, core/.env and app/.env.
# Compose reads those for substitution, not this file.
