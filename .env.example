# Shared INFRASTRUCTURE only (root docker-compose.yml): host ports and the
# credentials each container is created with. Copy to `.env`.
#
# Application settings and secrets are NOT here. Each service has its own:
#   api/.env    database + cache credentials, demo settings
#   core/.env   database + cache credentials, LiveKit key/secret, LLM, STT, TTS
#   app/.env    browser-facing service URLs
# Where a value must match (database password, LiveKit key/secret), the
# service's .env.example says so.
#
# The database and cache credentials are applied only when a data volume is
# first created. To change them afterwards, change them inside the service, or
# wipe the data with `docker compose down -v`.

# PostgreSQL (service `db`). In-network: db:5432.
DB_PORT=5433
DB_USER=capitalwise
DB_PASSWORD=capitalwise_dev
DB_NAME=capitalwise

# Redis (service `cache`). In-network: cache:6379.
CACHE_PORT=6380
CACHE_PASSWORD=capitalwise_dev

# LiveKit WebRTC server (service `media`). In-network: ws://media:7880.
# Also uses 7881/tcp and 7882/udp for media.
MEDIA_PORT=7880
MEDIA_API_KEY=capitalwise
# At least 32 characters.
MEDIA_API_SECRET=capitalwise_dev_media_secret_change_me_now
# The IP LiveKit advertises for media. 127.0.0.1 works on this machine (and for
# containers). Use this machine's LAN IP to open the phone page on a second
# device (that device also needs https or a browser flag for the microphone).
MEDIA_NODE_IP=127.0.0.1

# Speaches speech server (service `speech`). In-network: http://speech:8000/v1.
SPEECH_PORT=8000
# Models downloaded by the one-shot `speech-models` service.
SPEECH_MODELS="Systran/faster-whisper-small.en speaches-ai/Kokoro-82M-v1.0-ONNX"
