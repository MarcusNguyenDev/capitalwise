# Copy to `api/.env` and fill in. `api/.env` is gitignored — never commit a key.
#
# Docker Compose substitutes from this directory (api/ is the compose project
# directory), and the container loads the same file as its env, so one file
# covers both. Database and Redis credentials are NOT here — they live in the
# root .env, which the service also loads (`../.env`).

# ── Service ─────────────────────────────────────────────────────────────────
# Host port. The container always listens on 3002 in development.
API_PORT=3002
API_DEBUG_PORT=9230

# ── Application ─────────────────────────────────────────────────────────────
BANK_NAME=Demo Bank
# Enables POST /api/demo/reset (drops and reseeds the database).
DEMO_MODE=true
# Folder holding 01_schema.sql, 02_seed.sql, 03_views.sql (relative to api/).
DB_SQL_DIR=../db
# Journey durations for GET /api/compare (relative to api/).
COMPARE_JOURNEY_PATH=config/compare_journey.json

# ── Infrastructure (defaults shown; normally set once in ../.env) ───────────
# DB_HOST=localhost
# DB_PORT=5433
# DB_USER=capitalwise
# DB_PASSWORD=capitalwise_dev
# DB_NAME=capitalwise
# CACHE_HOST=localhost
# CACHE_PORT=6380
# CACHE_PASSWORD=capitalwise_dev
