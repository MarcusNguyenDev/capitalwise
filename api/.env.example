# Copy to `api/.env`. This is the ONLY config file the api service reads
# (`bun run start` and its container both load it). It is gitignored: keep
# secrets here, never in the repo.
#
# Docker Compose also substitutes API_PORT / API_DEBUG_PORT from it, and
# overrides DB_HOST/DB_PORT and CACHE_HOST/CACHE_PORT with the in-network
# addresses when the service runs in a container.

# ── Service ─────────────────────────────────────────────────────────────────
API_PORT=3002
API_DEBUG_PORT=9230

# ── Demo ────────────────────────────────────────────────────────────────────
BANK_NAME=Demo Bank
# Enables POST /api/demo/reset ("Reset demo" in the console).
DEMO_MODE=true
# Where the schema, seed and view SQL files live (used by demo reset).
DB_SQL_DIR=../db
# Step durations for the Before & after page. Re-read on every request.
COMPARE_JOURNEY_PATH=config/compare_journey.json

# ── Database (secret) ───────────────────────────────────────────────────────
# Must match the credentials the `db` container was created with (root .env).
DB_HOST=localhost
DB_PORT=5433
DB_USER=capitalwise
DB_PASSWORD=capitalwise_dev
DB_NAME=capitalwise

# ── Cache / live events (secret) ────────────────────────────────────────────
CACHE_HOST=localhost
CACHE_PORT=6380
CACHE_PASSWORD=capitalwise_dev
